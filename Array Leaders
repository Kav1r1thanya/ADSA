class Solution {
    static ArrayList<Integer> leaders(int arr[]) {
        // code here
        int n = arr.length;
        ArrayList<Integer> l = new ArrayList<>();
        int max = arr[n-1];
        l.add(max);
        
        for(int i=n-2;i>=0;i--)
        {
            if(arr[i]>=max)
            {
                l.add(arr[i]);
                max=arr[i];
            }
            
        }
        Collections.reverse(l);
        return l;
    }
}
