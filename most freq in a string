class Solution {
    public static char getMaxOccuringChar(String s) {
        // code here
        int[] c = new int[26];
        for(int i=0;i<s.length();i++)
        {
            c[s.charAt(i)-'a']++;
        }
        int max = 0;
        char ans = 'a';
        for(int i=0;i<26;i++)
        {
            if(c[i]>max)
            {
                max=c[i];
                ans = (char) ('a'+i);
            }
        }
        return ans;
    }
}
