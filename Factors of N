class Solution {
    public ArrayList<Integer> getDivisors(int n) {
        // code here
        ArrayList<Integer> l = new ArrayList<>();
        for(int i=1;i<=Math.sqrt(n);i++)
        {
            if(n%i==0)
            {
                l.add(i);
                if(i!=n/i)
                {
                    l.add(n/i);
                }
            }
        }
        Collections.sort(l);
        return l;
    }
}
