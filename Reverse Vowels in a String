class Solution {
    public String reverseVowels(String s) {
        int r = s.length()-1;
        int l = 0;
        char[] chars = s.toCharArray();
        while(l<r)
        {
            if(!IsVowel(chars[l]))
            {   
                l++;
            }
            else if(!IsVowel(chars[r]))
            {
                r--;
            }
            else
            {
               char temp = chars[l];
               chars[l] = chars[r];
               chars[r] = temp;
               l++;
               r--;
            }
        }
        String str = new String(chars);
        return str;
    }
    public boolean IsVowel(char c)
    {
        if(c=='a'||c=='e'||c=='i'||c=='o'||c=='u'||c=='A'||c=='E'||c=='I'||c=='O'||c=='U')
        {
            return true;
        }
        return false;
    }
}
