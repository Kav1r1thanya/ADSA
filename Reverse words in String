class Solution {
    public String reverseWords(String s) {
        char[] chars = s.toCharArray();
        int n = chars.length;
        int start =0;
        for(int i=0;i<=n;i++)
        {
            if(i==n || chars[i]==' ')
            {
                rev(chars,start,i-1);
                start = i+1;
            }
        }
        return new String(chars);

        
        
    }
    public void rev( char[] chars , int l, int r)
    {
        while(l<r)
        {
            char temp=chars[l];
            chars[l]=chars[r];
            chars[r]=temp;
            l++;
            r--;
        }
    }
}
