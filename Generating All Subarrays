class Solution {
    public List<List<Integer>> getSubArrays(int[] arr) {
        // code here
        List<List<Integer>> list = new ArrayList<>();
        List<Integer> sub = new ArrayList<>();
        int n = arr.length;
        for(int i=0;i<n;i++)
        {
            sub = new ArrayList<>();
            for(int j=i;j<n;j++)
            {
                sub.add(arr[j]);
                list.add(new ArrayList<>(sub));
            }
            
        }
        return list;
    }
}
